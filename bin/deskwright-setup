#!/usr/bin/env python3
"""Checkout-local launcher for deskwright-setup (the pip/uvx entry point is
`deskwright-setup = deskwright.setup_cli:main` in pyproject.toml)."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from deskwright.setup_cli import main

if __name__ == "__main__":
    sys.exit(main())
